# Local configuration template.
# Copy to .env (ignored by git) and fill values as needed.

# HuggingFace token for pyannote speaker diarization models.
HF_TOKEN=

# Optional Flask session secret for the local web UI.
FLASK_SECRET_KEY=

# Bind host. Defaults to localhost. Use 0.0.0.0 only for intentional LAN access.
WHISPER_LOCAL_HOST=127.0.0.1

# Required when WHISPER_LOCAL_HOST is 0.0.0.0 or ::.
WHISPER_LOCAL_AUTH_TOKEN=

# Optional upload limit for the Flask UI, in megabytes.
WHISPER_LOCAL_MAX_UPLOAD_MB=250

# Optional maximum accepted audio duration for uploads, in seconds.
WHISPER_LOCAL_MAX_AUDIO_DURATION_SECONDS=7200
